<idea-plugin>
    <id>com.anmi.devworkspace</id>
    <name>Dev Workspace</name>
    <vendor>Anmi</vendor>

    <description><![CDATA[
        <p>Personal developer workspace tools for IntelliJ IDEA.</p>
        <p>Version 0.1 provides a TOML-backed task runner using IDEA Terminal.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.DevWorkspaceBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Dev Workspace Library" displayType="BALLOON"/>
        <applicationConfigurable
                id="com.anmi.devworkspace.settings"
                parentId="tools"
                instance="com.anmi.devworkspace.settings.DevWorkspaceSettingsConfigurable"
                bundle="messages.DevWorkspaceBundle"
                key="settings.devworkspace.name"/>
        <applicationConfigurable
                id="com.anmi.devworkspace.settings.markmap"
                parentId="com.anmi.devworkspace.settings"
                instance="com.anmi.devworkspace.markmap.settings.MarkmapConfigurable"
                bundle="messages.DevWorkspaceBundle"
                key="settings.markmap.name"/>
        <projectService
                serviceInterface="com.anmi.devworkspace.terminal.TerminalGateway"
                serviceImplementation="com.anmi.devworkspace.terminal.idea262.Idea262TerminalGateway"/>
        <toolWindow
                id="Dev Tasks"
                anchor="right"
                factoryClass="com.anmi.devworkspace.ui.DevTasksToolWindowFactory"
                canCloseContents="false"/>
        <toolWindow
                id="Dev Library"
                anchor="right"
                factoryClass="com.anmi.devworkspace.library.ui.LibraryToolWindowFactory"
                canCloseContents="false"/>
    </extensions>

    <!-- Action System resolves action.<full-id>.* from this bundle for Tools, Find Action, Keymap, and context menus. -->
    <actions resource-bundle="messages.DevWorkspaceBundle">
        <action
                id="DevWorkspace.OpenLibrary"
                class="com.anmi.devworkspace.library.actions.OpenLibraryAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
                id="DevWorkspace.QuickAddLibrary"
                class="com.anmi.devworkspace.library.actions.QuickAddLibraryAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
                id="DevWorkspace.AddEditorContextToLibrary"
                class="com.anmi.devworkspace.library.actions.AddEditorContextToLibraryAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="DevWorkspace.AddProjectFilesToLibrary"
                class="com.anmi.devworkspace.library.actions.AddProjectFilesToLibraryAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
